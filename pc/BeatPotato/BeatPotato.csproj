<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BeatPotato</RootNamespace>
    <AssemblyName>BeatPotato</AssemblyName>
    <ApplicationIcon>..\..\assets\potato\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 素材单一真源在仓库根 assets/，构建时拷入输出目录 -->
    <Content Include="..\..\assets\potato\*.png" Link="assets\potato\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\potato\*.jpg" Link="assets\potato\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\potato\*.ico" Link="assets\potato\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\potato\counter\*.png" Link="assets\potato\counter\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\potato\state\*.png" Link="assets\potato\state\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\audio\*.wav" Link="assets\audio\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
